    add('공시지원 효율',pickBest(list.filter(x=>x.support),used,category,(a,b)=>b.supportRatio-a.supportRatio||a.support.total24-b.support.total24));
    add('월 부담 균형',pickBest(list,used,category,(a,b)=>Math.abs(a.best.monthly-60000)-Math.abs(b.best.monthly-60000)||a.best.total24-b.best.total24));
