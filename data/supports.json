  function deviceImage(d){return typeof window.woongbiDeviceImage==='function'?window.woongbiDeviceImage(d):''}
  function brand(d){const s=clean(`${d?.name} ${d?.manufacturer} ${d?.model} ${d?.model_code}`);return /아이폰|iphone|apple|애플/.test(s)?'apple':/갤럭시|galaxy|samsung|삼성/.test(s)?'samsung':'other'}
  function visible(d){const s=clean(`${d?.name} ${d?.manufacturer} ${d?.model} ${d?.model_code}`);const custom=state.overrides?.recommendation_policy?.excluded_devices_by_carrier?.[d?.carrier]?.name_tokens||[];if(custom.some(x=>s.includes(clean(x))))return false;return !(d?.carrier==='LGU+'&&(/모토로라|motorola|moto/.test(s)))}
  function handsetPlan(p){const s=clean(`${p?.name} ${p?.description}`);return !/(^|[^a-z0-9])[23]g([^a-z0-9]|$)/i.test(s)&&!/아웃도어|tab|태블릿|watch|워치|포켓파이|데이터함께쓰기|데이터쉐어링|데이터셰어링|아이패드|ipad|세컨드디바이스|2nddevice|wearable|웨어러블|데이터나눠쓰기/.test(s)}
  function kidsDevice(d){return /무너|zem폰|포켓피스|키즈폰|폼폼푸린|pompompurin|춘식이키즈|신비키즈|신비아파트/.test(clean(`${d?.name} ${d?.model} ${d?.model_code}`))}
  function folderDevice(d){return /스타일폴더|폴더폰|folder/.test(clean(`${d?.name} ${d?.model} ${d?.model_code}`))}
  function premiumFamily(d){const s=clean(`${d?.name} ${d?.model} ${d?.model_code}`);if(/s26ultra/.test(s))return's26ultra';if(/s26\+|s26plus/.test(s))return's26plus';if(/갤럭시s26|galaxys26/.test(s))return's26';if(/폴드8|fold8/.test(s))return'fold8';if(/플립8|flip8/.test(s))return'flip8';if(/아이폰18|iphone18/.test(s))return'iphone18';return''}
  function storage(d){const s=clean(`${d?.name} ${d?.model} ${d?.model_code}`);return /2tb/.test(s)?2048:/1tb/.test(s)?1024:/512gb|512g/.test(s)?512:/256gb|256g/.test(s)?256:/128gb|128g/.test(s)?128:null}
  function audienceAllowed(p,category){const a=String(p?.age_limit||'ALL').toUpperCase(),n=clean(p?.name);if(/복지|장애|국가유공|손누리|소리누리|현역병|군인/.test(n))return false;if(category==='senior')return ['ALL','O_19',''].includes(a)||/65|75/.test(a)||/시니어|65\+|75\+/.test(n);return ['ALL','O_19',''].includes(a)}
  function eligibleIds(d,join){const m=d?.eligible_plan_ids_by_join_type||{};const ids=Array.isArray(m[join])?m[join]:d?.eligible_plan_ids;return Array.isArray(ids)?ids:[]}
  function validPublicSupport(value,device){return num(value)&&Number.isSafeInteger(Number(value))&&Number(value)>=0&&num(device?.retail_price)&&Number(device.retail_price)>0&&Number(value)<=Number(device.retail_price)}
  function supportFor(d,p,join){const direct=(state.catalog?.mobile_supports||[]).find(x=>x.device_id===d.id&&x.plan_id===p.id&&x.join_type===join);if(direct)return validPublicSupport(direct.public_support,d)?Number(direct.public_support):null;const row=(state.supports?.support_schedules||[]).find(x=>x.carrier===d.carrier&&Array.isArray(x.device_ids)&&x.device_ids.includes(d.id)&&Array.isArray(x.join_types)&&x.join_types.includes(join)&&x.amounts&&num(x.amounts[p.id]));return row&&validPublicSupport(row.amounts[p.id],d)?Number(row.amounts[p.id]):null}
  function finance(principal,months=24){principal=Math.max(0,Number(principal)||0);if(!principal)return{monthly:0,total:0,fee:0};const r=.059/12,pow=Math.pow(1+r,months),monthly=principal*r*pow/(pow-1),total=monthly*months;return{monthly,total,fee:Math.max(0,total-principal)}}
  function welfare(type,fee){fee=Math.max(0,Number(fee)||0);if(type==='basic_pension')return Math.min(12100,.5*fee);return 0}
  function quote(d,p,join,method,welfareType){if(!d||!p||!num(d.retail_price)||!num(p.monthly_fee))return null;const price=Number(d.retail_price),fee=Number(p.monthly_fee),months=24,support=supportFor(d,p,join);if(method==='support'&&!num(support))return null;const publicSupport=method==='support'?Number(support):0,principal=Math.max(0,price-publicSupport),inst=finance(principal,months),contractDiscount=method==='contract'?fee*.25:0,afterContract=Math.max(0,fee-contractDiscount),welfareAmount=welfare(welfareType,afterContract),service=Math.max(0,afterContract-welfareAmount),monthly=inst.monthly+service;return{method,price,planFee:fee,support:publicSupport,principal,inst,contractDiscount,welfareAmount,service,monthly,total24:inst.total+service*24}}
  function releaseAge(d){const s=String(d?.release_date||'');if(!/^\d{4}-\d{2}-\d{2}/.test(s))return 9999;const ms=Date.now()-new Date(`${s.slice(0,10)}T00:00:00+09:00`).getTime();return Math.max(0,Math.round(ms/86400000))}
  function policyIndex(d){const arr=state.overrides?.recommendation_policy?.senior_priority||[];const s=clean(`${d?.name} ${d?.model} ${d?.model_code}`);const i=arr.findIndex(x=>s.includes(clean(x)));return i<0?99:i}
  function seniorCarrierPriority(d){return clean(d?.name)==='스타일폴더2'?(d?.carrier==='SKT'?0:d?.carrier==='LGU+'?1:2):2}
  function deviceKey(d,category){if(category==='premium'){const f=premiumFamily(d);if(f)return f}return clean(d?.name||d?.model_code||d?.id).replace(/(skt|kt|lgu\+|lgu)$/g,'')}
  function dataGB(p){const s=clean(p?.data);if(!s)return 0;if(s==='무제한'||s.includes('완전무제한'))return 1e6;let m=s.match(/([\d.]+)gb/);if(m)return Number(m[1]);m=s.match(/([\d.]+)mb/);if(m)return Number(m[1])/1024;return s.includes('무제한')?1e4:0}
  function methodReason(c){if(c.support&&c.contract){const diff=Math.abs(c.support.total24-c.contract.total24);if(diff<500)return'공시지원·선택약정 부담이 비슷함';return c.best.method==='support'?`공시지원이 24개월 기준 ${won(diff)} 유리`:`선택약정이 24개월 기준 ${won(diff)} 유리`}return c.best.method==='support'?'공시지원 기준 계산':'선택약정 25% 기준 계산'}
  function comboReason(c,category){const reasons=[methodReason(c)];if(category==='senior'){
    if(policyIndex(c.d)===0)reasons.unshift(folderDevice(c.d)?'폴더형·버튼 사용 편의 우선':'매장 효도폰 우선 후보');
    if(c.welfare==='basic_pension')reasons.push('기초연금 수급자 할인 반영');
    if(c.best.monthly<50000)reasons.push('월 부담 5만원 미만');
  }else if(category==='value'){
    if(c.supportRatio>=.3)reasons.push('출고가 대비 공시지원 비율 높음');
    if(c.best.monthly<70000)reasons.push('월 부담 7만원 미만');
    if(releaseAge(c.d)<=180)reasons.push('최근 출시 단말');
  }else if(category==='premium'){
    if(c.support?.support>=400000)reasons.push(`공시지원 ${won(c.support.support)}`);
    const cap=storage(c.d);if(cap)reasons.push(`${cap}GB 저장용량`);
    if(releaseAge(c.d)<=180)reasons.push('최근 출시 라인업');
  }
    return reasons.slice(0,3);
  }
  function planBounds(category){return category==='senior'?[30000,60000]:category==='value'?[33000,75000]:[55000,130000]}
  function deviceAllowed(d,category){if(!visible(d)||kidsDevice(d)||!num(d.retail_price)||Number(d.retail_price)<=0)return false;const price=Number(d.retail_price);if(category==='senior')return policyIndex(d)<99||folderDevice(d)||(brand(d)==='samsung'&&price<=800000);if(category==='value')return !folderDevice(d)&&!premiumFamily(d)&&price>=300000&&price<=950000;if(category==='premium'){const f=premiumFamily(d),cap=storage(d);return!!f&&(cap===256||cap===512)}return false}
  function buildCombos(category,carrier,join,pension){const [minFee,maxFee]=planBounds(category),welfareType=category==='senior'&&pension?'basic_pension':'none',plans=state.plans?.mobile_plans||[],devices=state.catalog?.devices||[],out=[];for(const d of devices){if((carrier!=='all'&&d.carrier!==carrier)||!deviceAllowed(d,category))continue;const ids=eligibleIds(d,join);if(!ids.length)continue;const allowed=new Set(ids);for(const p of plans){if(p.carrier!==d.carrier||!allowed.has(p.id)||!handsetPlan(p)||!num(p.monthly_fee)||!audienceAllowed(p,category))continue;const fee=Number(p.monthly_fee);if(fee<minFee||fee>maxFee)continue;const s=quote(d,p,join,'support',welfareType),ct=quote(d,p,join,'contract',welfareType),known=[s,ct].filter(Boolean).sort((a,b)=>a.total24-b.total24);if(!known.length)continue;const best=known[0],supportRatio=s&&s.price?Math.min(1,s.support/s.price):0;out.push({d,p,best,support:s,contract:ct,welfare:welfareType,supportRatio,dataScore:dataGB(p),age:releaseAge(d),policy:policyIndex(d),join})}}
    return out;
  }
  function pickBest(list,used,category,compare){const candidates=list.filter(x=>!used.has(deviceKey(x.d,category))).sort(compare);const c=candidates[0];if(c)used.add(deviceKey(c.d,category));return c||null}
  function select(category,list){const used=new Set(),picked=[];const add=(lane,c)=>{if(c)picked.push({...c,lane})};if(category==='senior'){
    add('월 부담 우선',pickBest(list,used,category,(a,b)=>a.best.monthly-b.best.monthly||a.best.total24-b.best.total24));
    add('사용 편의 우선',pickBest(list,used,category,(a,b)=>a.policy-b.policy||seniorCarrierPriority(a.d)-seniorCarrierPriority(b.d)||(folderDevice(b.d)?1:0)-(folderDevice(a.d)?1:0)||a.best.monthly-b.best.monthly));
    add('최신 실속 후보',pickBest(list,used,category,(a,b)=>a.age-b.age||a.best.total24-b.best.total24));
  }else if(category==='value'){
